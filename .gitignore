# Secrets (NFR-07). Only the *.example templates are committed.
.env
.env.*
!.env.example
deploy/env/*.env
!deploy/env/models-*.env

*.pem
*.key
var/

# Databases and indexes
*.db
*.db-wal
*.db-shm
chroma/

# Corpus raw and extracted text are never committed (BRD §10, L3/L4)
data/corpus/raw/
data/corpus/text/
data/corpus/quarantine/
data/corpus/manifest.lock.yaml

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
dist/
/build/
*.egg-info/
.cache/

# JS (apps/web)
node_modules/

# Tooling state
.claude/.stop_retries
.DS_Store

# Third-party PDFs are never committed (BRD §10, legal basis L4)
docs/**/*.pdf

# Office lock files (an open CORPUS_INDEX.xlsx)
~$*

# Baseline response cache (re-runs are free; results and summary are committed)
evaluation/baseline/cache/
evaluation/baseline/results/

# Next.js build output (apps/web)
apps/web/.next/
apps/web/out/
apps/web/tsconfig.tsbuildinfo
