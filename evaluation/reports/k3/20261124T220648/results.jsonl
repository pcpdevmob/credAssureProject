{"id": "T001", "category": "regulatory", "subtype": null, "passed": false, "failure_class": "wrong_citation", "brd_class": "search_miss", "detail": "no cited document supports the answer", "latency_s": 48.5, "llm_calls": 1, "tokens": 3721, "cost": 0.0, "answer": {"answer": "The CGTMSE annual guarantee fee is charged on the guaranteed amount for the first year [R-CG-C-396#section#14]. For the remaining tenure of the credit facilities, it is charged on the outstanding amount [R-CG-C-396#section#14].", "citations": ["R-CG-C-396"], "refused": false, "ranking": null}, "trace_ids": ["eb485aaa6b7e4d439b0363d819b308cf"]}
