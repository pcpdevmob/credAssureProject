{"id": "T013", "category": "regulatory", "subtype": null, "passed": false, "failure_class": "wrong_citation", "brd_class": "search_miss", "detail": "no cited document supports the answer", "latency_s": 38.97, "llm_calls": 1, "tokens": 3658, "cost": 0.0, "answer": {"answer": "The interest paid on late payment to a micro or small enterprise supplier is not allowed as a deduction from income under the Income-tax Act, 1961 [R-MSME-01#section#75].", "citations": ["R-MSME-01"], "refused": false, "ranking": null}, "trace_ids": ["68d8b21cdbc14120abc43181b08ce69e"]}
{"id": "T014", "category": "regulatory", "subtype": null, "passed": true, "failure_class": null, "brd_class": null, "detail": "", "latency_s": 25.41, "llm_calls": 1, "tokens": 1870, "cost": 0.0, "answer": {"answer": "TReDS is an electronic platform for facilitating the financing/discounting of trade receivables of MSMEs through multiple financiers [R-RBI-FAQ-003#section#1]. It helps MSMEs by enabling them to convert their trade receivables into finance [R-SANSAD-019#section#5].", "citations": ["R-RBI-FAQ-003", "R-SANSAD-019"], "refused": false, "ranking": null}, "trace_ids": ["cfe31058384741a7bfadcc23b0bcc558"]}
{"id": "T015", "category": "regulatory", "subtype": null, "passed": true, "failure_class": null, "brd_class": null, "detail": "", "latency_s": 39.12, "llm_calls": 1, "tokens": 3759, "cost": 0.0, "answer": {"answer": "The RBI policy repo rate as of November 2026 is 5.50 per cent [R-RATE-02-REPO#section#0].", "citations": ["R-RATE-02-REPO"], "refused": false, "ranking": null}, "trace_ids": ["2fe6981135e2470ca8ef7fe31f0f18c7"]}
