{"id": "T011", "category": "regulatory", "subtype": null, "passed": false, "failure_class": "wrong_citation", "brd_class": "search_miss", "detail": "no cited document supports the answer", "latency_s": 39.08, "llm_calls": 2, "tokens": 3994, "cost": 0.0, "answer": {"answer": "The buyer must pay the supplier within 45 days from the date of acceptance or the day of deemed acceptance [R-RBI-04#section#26][R-RBI-05#section#4].", "citations": ["R-RBI-04", "R-RBI-05"], "refused": false, "ranking": null}, "trace_ids": ["6d456f040ca5498ea0e2f1351de93588"]}
