# Server .env for the hosted deployment (docs/deployment/azure.md §6). On the VM:
#   cp deploy/env/server.env.example .env && chmod 600 .env && nano .env
# Read after deploy/env/models-hosted.env, so anything here wins. Never commit the filled file.
# Generate secrets on the VM:
#   JWT_SECRET:          openssl rand -base64 48
#   MFA_ENCRYPTION_KEY:  openssl rand -base64 32      (keep it: losing it means everyone re-enrols MFA)

# --- Address (Caddy gets the HTTPS certificate for it) ---
DOMAIN=credassure.sharentest.com

# --- Course endpoint (first): group key and its CA file copied to var/certs/ ---
LLM_API_KEY=
LLM_CA_CERT=/app/var/certs/course-ca.pem

# --- Hugging Face → Featherless (fallback): fine-grained token, "Make calls to Inference Providers" ---
LLM_FALLBACK_API_KEY=
# If the course endpoint does not answer from the VM (VPN-only), use Hugging Face only:
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=Qwen/Qwen3-8B:featherless-ai
# LLM_API_KEY=<the same Hugging Face token>
# LLM_CA_CERT=
# LLM_FALLBACK_BASE_URL=
# LLM_RATE_PER_MINUTE=60

# --- Sign-in (ADR 0038) ---
JWT_SECRET=
MFA_ENCRYPTION_KEY=
# MFA is enforced for director_finance, vp_finance and user_admin (models-hosted.env: MFA_ENFORCED=true).

# --- Accounts (ADR 0038): each has its own password. Accounts without a line below get a random
# first password in var/initial-passwords.txt and change it at first sign-in. 12+ characters, all different.
SEED_PASSWORD_DEMO_PREPARER=     # demo_reset.py creates the demo cases as this account
SEED_PASSWORD_PREP_E001=         # smoke.sh signs in as this account
