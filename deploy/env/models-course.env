# MODELS=course: graded course endpoints (NFR-01). URLs are for groups 016-030 (chat vm06, embeddings vm02).
# Loaded by the Makefile after .env. Secrets and machine paths stay in .env, never here:
#   LLM_API_KEY, EVAL_API_KEY (group chat key), EMBED_API_KEY (shared embedding key),
#   LLM_CA_CERT=<abs path>/vm06-ca.crt, EMBED_CA_CERT=<abs path>/vm02-ca.crt
LLM_BASE_URL=https://103.42.50.41:1032/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_DISABLE_THINKING=true
# vLLM switch; confirm with `make llm-probe MODELS=course` before relying on it
LLM_THINKING_SWITCH=chat_template_kwargs
LLM_MAX_TOKENS=1024
LLM_RATE_PER_MINUTE=55
EMBED_BASE_URL=https://103.42.50.41:1035/v1
EMBED_MODEL=bge-small-en-v1.5
EMBED_BATCH=16
EMBED_RATE_PER_MINUTE=60
CHROMA_PATH=var/chroma-course-bge
EVAL_BASE_URL=https://103.42.50.41:1032/v1
EVAL_MODEL=Qwen/Qwen3-8B
EVAL_MAX_TOKENS=1024
EVAL_DISABLE_THINKING=true
EVAL_NUM_CTX=8192

# Retrieval (plan v3.4 P4, chosen on the dev split 2026-11-18; evaluation/reports/retrieval-ladder-2026-11-18.md)
RETRIEVAL_CONTEXT_HEADERS=true
RETRIEVAL_QUERY_REWRITE=true
RERANKER=local_cross_encoder
RERANK_ORDER=false
ANSWERABILITY_THRESHOLD=0.4066
