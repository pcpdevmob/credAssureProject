# Accounts for `make e2e-report ARGS="--live e2e-live.env"`: copy to e2e-live.env in the repo root (git-ignored),
# chmod 600, fill in the temporary passwords. The tool changes each password at first sign-in, sets up the
# authenticator for the Director, VP and admin accounts itself, and writes the new values back to this file:
# keep the file, delete it to start over (an admin then resets those accounts). Never paste it into a chat.
BASE_URL=https://credassure.148-230-103-29.sslip.io

# Preparers must be seeded accounts: the preparer check reads the HR record bound to the account.
ROLE_PREPARER=prep.e002
ROLE_PREPARER2=prep.e003
# Created by it.admin in User management (no HR id needed):
ROLE_DIRECTOR=e2e.director
ROLE_VP=e2e.vp
ROLE_EVALUATOR=e2e.evaluator
ROLE_ADMIN=e2e.admin

# First passwords: the e2e.* ones from User management, the prep.* ones from var/initial-passwords.txt on the server.
PW_prep.e002=
PW_prep.e003=
PW_e2e.director=
PW_e2e.vp=
PW_e2e.evaluator=
PW_e2e.admin=
# Optional: the HR-profile accounts for the preparer-check tests (each is skipped without a password).
PW_prep.e009=
PW_prep.e012=
PW_prep.e014=
PW_prep.e017=
PW_prep.e019=
PW_prep.e020=
