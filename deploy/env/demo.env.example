# Demo profile: live model with replay fallback (ADR 0015), self-hosted Langfuse (ADR 0016).
# Copy to deploy/env/demo.env (gitignored) and fill in JWT_SECRET. Model defaults are Ollama
# (ADR 0017); Compose overrides the URLs to http://ollama:11434/v1. For the course endpoint,
# set LLM_BASE_URL, LLM_MODEL, LLM_API_KEY, LLM_CA_CERT, EMBED_BASE_URL and EMBED_MODEL to the course values.
APP_ENV=demo
LOG_LEVEL=INFO
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_DISABLE_THINKING=true
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text
# Course embeddings (graded): EMBED_BASE_URL=https://<course host>/v1, EMBED_MODEL=bge-small-en-v1.5,
# EMBED_API_KEY=<from coordinator>, EMBED_CA_CERT=<absolute path to the course CA file>, EMBED_BATCH=16,
# and a fresh CHROMA_PATH (384-dim vectors, re-index)
LLM_CONTEXT_TOKENS=8192
LLM_ENABLED=true
# Endpoint slow on the day? Set REPLAY_MODE=true: replies recorded by the rehearsal run, no endpoint calls.
REPLAY_MODE=false
TRACING_ENABLED=true
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
JWT_SECRET=
BOUNDARY_RULE=hold
AS_OF_DATE=2026-11-15
CREDASSURE_SEED=20261026
