# MODELS=hf: Qwen/Qwen3-8B through Hugging Face Inference Providers, provider Featherless AI (deployment plan,
# 20 Nov 2026). Same model as the evaluated local qwen3:8b, served at FP8. Loaded by the Makefile after .env.
# The token stays in .env, never here:
#   LLM_API_KEY=<Hugging Face fine-grained token with "Make calls to Inference Providers">
#   EVAL_API_KEY=<same token> (baseline / judge scripts)
# Embeddings, reranker and the vector index stay in-process and local, exactly as MODELS=local.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3-8B:featherless-ai
LLM_CA_CERT=
LLM_DISABLE_THINKING=true
# vLLM-style switch; confirm with `make llm-probe MODELS=hf` (the app also strips any <think> block)
LLM_THINKING_SWITCH=chat_template_kwargs
LLM_MAX_TOKENS=1024
LLM_RATE_PER_MINUTE=60
EMBED_BASE_URL=local
EMBED_CA_CERT=
EMBED_API_KEY=
CHROMA_PATH=var/chroma-local-bge
EVAL_BASE_URL=https://router.huggingface.co/v1
EVAL_MODEL=Qwen/Qwen3-8B:featherless-ai
EVAL_MAX_TOKENS=1024
EVAL_DISABLE_THINKING=true
EVAL_NUM_CTX=8192

# Retrieval (plan v3.4 P4, chosen on the dev split 2026-11-18), identical to models-local.env
RETRIEVAL_CONTEXT_HEADERS=true
RETRIEVAL_QUERY_REWRITE=true
RERANKER=local_cross_encoder
RERANK_ORDER=false
ANSWERABILITY_THRESHOLD=0.4066
