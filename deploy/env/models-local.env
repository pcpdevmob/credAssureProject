# MODELS=local (default): everything on this machine, no quota, no keys (ADR 0017).
# Loaded by the Makefile after .env, so these values win. Course keys and CA paths in .env
# are blanked here so local mode never sends or loads them.
# Needs: `OLLAMA_CONTEXT_LENGTH=8192 ollama serve` and `make ollama-pull` (qwen3:8b).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_CA_CERT=
EMBED_CA_CERT=
EMBED_API_KEY=
LLM_DISABLE_THINKING=true
# Ollama ignores /no_think and chat_template_kwargs; reasoning_effort=none works (probed 0.40.16)
LLM_THINKING_SWITCH=reasoning_effort
LLM_MAX_TOKENS=1024
LLM_RATE_PER_MINUTE=600
EMBED_BASE_URL=local
CHROMA_PATH=var/chroma-local-bge
EVAL_BASE_URL=http://localhost:11434/v1
EVAL_MODEL=qwen3:8b
EVAL_API_KEY=
EVAL_MAX_TOKENS=1024
EVAL_DISABLE_THINKING=true
EVAL_NUM_CTX=8192

# Retrieval (plan v3.4 P4, chosen on the dev split 2026-11-18; evaluation/reports/retrieval-ladder-2026-11-18.md)
RETRIEVAL_CONTEXT_HEADERS=true
RETRIEVAL_QUERY_REWRITE=true
RERANKER=local_cross_encoder
RERANK_ORDER=false
ANSWERABILITY_THRESHOLD=0.4066
