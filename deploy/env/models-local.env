# MODELS=local (default): everything on this machine, no quota, no keys (ADR 0017).
# Loaded by the Makefile after .env, so these values win. Course keys and CA paths in .env
# are blanked here so local mode never sends or loads them.
# Needs: `OLLAMA_CONTEXT_LENGTH=8192 ollama serve` and `make ollama-pull` (qwen3:8b).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_CA_CERT=
EMBED_CA_CERT=
EMBED_API_KEY=
LLM_DISABLE_THINKING=true
LLM_MAX_TOKENS=1024
LLM_RATE_PER_MINUTE=600
EMBED_BASE_URL=local
CHROMA_PATH=var/chroma-local-bge
EVAL_BASE_URL=http://localhost:11434/v1
EVAL_MODEL=qwen3:8b
EVAL_API_KEY=
EVAL_MAX_TOKENS=1024
EVAL_DISABLE_THINKING=true
EVAL_NUM_CTX=8192
