# Hosted deployment (Azure VM, deploy/compose/production.yaml; docs/deployment/azure.md).
# Chat: course Qwen/Qwen3-8B first, Hugging Face → Featherless Qwen/Qwen3-8B as automatic fallback
# (FailoverLLM). Retrieval: exactly the evaluated local settings (models-local.env): in-process
# bge-small embeddings, the var/chroma-local-bge index, bge reranker, query rewrite, answerability gate.
# No secrets here: LLM_API_KEY (course group key), LLM_FALLBACK_API_KEY (HF token), JWT_SECRET,
# MFA_ENCRYPTION_KEY, the seed passwords and LLM_CA_CERT (the course CA, /app/var/certs/...) go
# in the server's .env (deploy/env/server.env.example); it is read after this file and wins.
# Paths are inside the container (WORKDIR /app; the host's var/ is mounted at /app/var).
APP_ENV=demo
TENANT_ID=demo
LLM_ENABLED=true
LLM_BASE_URL=https://103.42.50.41:1032/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_CA_CERT=
LLM_DISABLE_THINKING=true
LLM_THINKING_SWITCH=chat_template_kwargs
LLM_MAX_TOKENS=1024
LLM_RATE_PER_MINUTE=55
LLM_FALLBACK_BASE_URL=https://router.huggingface.co/v1
LLM_FALLBACK_MODEL=Qwen/Qwen3-8B:featherless-ai
EMBED_BASE_URL=local
EMBED_CA_CERT=
EMBED_API_KEY=
CHROMA_PATH=var/chroma-local-bge
RETRIEVAL_CONTEXT_HEADERS=true
RETRIEVAL_QUERY_REWRITE=true
RERANKER=local_cross_encoder
RERANK_ORDER=false
ANSWERABILITY_THRESHOLD=0.4066
TRACING_ENABLED=false
MFA_ENFORCED=true
HF_HUB_OFFLINE=1
