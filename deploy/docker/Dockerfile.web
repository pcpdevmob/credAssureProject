# Web image (multi-stage, non-root). The unprivileged nginx image listens on 8080.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web apps/web
COPY packages/api-client packages/api-client
COPY docs/help docs/help
# Hosted build: API_BASE= (empty) makes the app call /v1 on its own origin (Caddy routes it).
ARG API_BASE=http://localhost:8000
ENV NEXT_PUBLIC_API_BASE_URL=$API_BASE
RUN pnpm install --frozen-lockfile && pnpm --filter @credassure/web build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/apps/web/out /usr/share/nginx/html
# P8.4 (scope #52): security headers in the container too, not only on the host proxy.
COPY deploy/nginx/security-headers.conf /etc/nginx/snippets/credassure-security-headers.conf
COPY deploy/nginx/web-container.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
