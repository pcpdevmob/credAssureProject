#!/usr/bin/env bash
# CI was removed on purpose (cd57a3e, at the user's request); these local gates replace it (ADR 0027).
# Skip once with --no-verify only when you know why.
set -euo pipefail
make check-fast    # includes test_openapi_current, so openapi.json is fresh before the diff below
make openapi-diff
# Scope #51: the Schemathesis fuzz is marked slow, so check-fast skips it; ~4 min for the three roles.
uv run pytest -q -m slow apps/gateway/tests/test_phase10_contract.py
# Scope #36: a prompt change on this branch needs the version-bump check and the fast eval subset.
if ! git diff --quiet main...HEAD -- '*/prompts/*'; then
  make eval-fast PROMPTS_BASE=main
fi
