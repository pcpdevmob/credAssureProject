# CredAssure settings (apps/gateway/src/credassure/gateway/settings.py). Copy to .env and fill in.
# Never commit .env. Startup fails outside APP_ENV=test if JWT_SECRET (>=32 chars) is missing,
# or if LLM_BASE_URL is missing while LLM_ENABLED=true.

APP_ENV=dev                     # dev | test | demo
LOG_LEVEL=INFO
TENANT_ID=default

# Local default is Ollama (ADR 0017): qwen3:8b chat (same family as the course model) + nomic-embed-text.
# Graded eval, course Qwen3-8B (groups 016-030 → vm06; key from the coordinator, never committed):
#   endpoint and model come from deploy/env/models-course.env (make ... MODELS=course); put the
#   group key in LLM_API_KEY and EVAL_API_KEY and the vm06 CA file path in LLM_CA_CERT here.
#   Limits: 1 active request per key (a 2nd gets 429), 60/min, 8192 tokens in+out, 1024 output max.
# Inside Compose the gateway uses http://ollama:11434/v1 instead of localhost.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama             # Ollama ignores it; the OpenAI SDK refuses an empty key
LLM_MODEL=qwen3:8b
LLM_CONTEXT_TOKENS=8192        # matches OLLAMA_CONTEXT_LENGTH; not Llama 3.1's 128k default
LLM_SUPPORTS_GUIDED_JSON=false # Phase 6 probes Ollama JSON mode before turning this on
# LLM_CA_CERT=                  # course endpoint: absolute path to its CA file (self-signed)
LLM_MAX_TOKENS=1024            # output cap per call; course max 1024 (its default is 512)
LLM_DISABLE_THINKING=true      # Qwen3: no think block; it would eat the output cap and break JSON
LLM_ENABLED=true               # false = template fallbacks; core workflow must still pass
# Model-call resilience (ADR 0008; scope #22, #23, #48)
LLM_CALL_TIMEOUT_S=30           # per attempt; a hung call ends as a SUP_TIMEOUT blocker
STAGE_TIMEOUT_S=300             # per stage; state is saved and the orphan is cancelled
LLM_MAX_RETRIES=2               # transient errors only (connection, timeout, 429, 5xx)
LLM_CIRCUIT_FAILURES=5          # consecutive failed calls before the circuit opens
LLM_CIRCUIT_OPEN_S=60           # while open, stages run on templates
LLM_RATE_PER_MINUTE=60          # shared limiter: agents and the baseline harness (NFR-04)
LLM_CACHE_PATH=var/llm_cache.db # empty = no response cache
REPLAY_MODE=false              # true = recorded replies only (demo fallback, ADR 0015)
# Embeddings, three choices (ADR 0017). KR-05 numbers only from course or local bge (same 384-dim model):
#   course (graded): vm02 endpoint and bge-small-en-v1.5 from deploy/env/models-course.env, plus
#     the shared embedding key in EMBED_API_KEY and the vm02 CA file path in EMBED_CA_CERT
#   local bge:  EMBED_BASE_URL=local  (in-process BAAI/bge-small-en-v1.5; EMBED_LOCAL_REVISION pins it)
#   Ollama:     the two lines below (nomic, 768-dim; never compare with the other two)
# Each choice needs its own CHROMA_PATH: vector sizes differ.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text   # changing this later requires a re-index
EMBED_API_KEY=                  # empty: LLM_API_KEY, only when EMBED_BASE_URL has the LLM host
EMBED_RATE_PER_MINUTE=600       # embedding batches per minute (NFR-04); lower it on the course endpoint
EMBED_CACHE_PATH=var/embed_cache.db
EMBED_CA_CERT=                  # course endpoint: absolute path to its CA file (self-signed)
EMBED_BATCH=16                  # texts per request; the course endpoint allows at most 16
CORPUS_DB=var/corpus.db         # make ingest (Phase 7)
CHROMA_PATH=var/chroma
RERANKER=none                   # none | local_cross_encoder (ADR 0013; llm_pointwise is refused)
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_REVISION=2cfc18c9415c912f9d8155881c133215df768a70  # pinned commit; change only with a re-run retrieval eval
RETRIEVAL_CONTEXT_HEADERS=false  # P4 scope #61: prepend publisher/title/section/date to section chunks at ingest (re-indexes)
RETRIEVAL_QUERY_REWRITE=false    # P4 scope #62: glossary expansion (config/glossary.yaml)
RERANK_ORDER=true                # P4: false = the reranker only scores for the answerability gate; hybrid order kept
# ANSWERABILITY_THRESHOLD=        # P4 scope #63: abstain below this top reranker score; chosen on the dev split only

# Tracing: self-hosted Langfuse (ADR 0016). Keys come from the Langfuse UI after first start.
TRACING_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Auth
JWT_SECRET=
JWT_EXPIRY_MINUTES=30
JWT_SESSION_MAX_MINUTES=240      # refresh renews a token until 4 h after sign-in (H12)
UI_ORIGINS=http://localhost:3000,http://localhost:5173

# Seed users for `make db` (Phase 5): 12+ characters, synthetic demo users only, never a real password.
# SEED_PASSWORD_<USERNAME> (dots as underscores, upper case) overrides it for one user.
SEED_PASSWORD=

# Playwright e2e (apps/web). E2E_PASSWORD falls back to SEED_PASSWORD_<USER>, then SEED_PASSWORD.
E2E_USERNAME=demo.preparer
E2E_PASSWORD=
E2E_BASE_URL=http://localhost:3000
CASE_DB=var/case.db
RATE_LIMIT=120/minute          # per user, else per IP (NFR-04)
TOKEN_QUOTA=2000000            # team token quota; 70% / 90% warnings (scope #16)
MAX_UPLOAD_BYTES=2097152       # 2 MB upload cap (UI-02)

# Corpus fetches (ADR 0020), both optional: a contact added to the scripted User-Agent.
# Email wins, else URL, else "CredAssure-capstone/1.0 (IIT KGP academic project)".
CORPUS_CONTACT_EMAIL=
CORPUS_CONTACT_URL=

# Money, routing and gates (exact values; BRD §8)
GST_RATE=0.18
APR_CONVENTION=nominal          # nominal | effective (ADR 0012)
BOUNDARY_RULE=hold              # hold | director | vp (APR-03)
APPROVAL_THRESHOLD_PAISE=1500000000
APPROVAL_STEP_UP=true           # NFR-07: approving above ₹1.5 crore asks for the password again
FORECAST_WEEKS=26
AGENT_MAX_STEPS=10
TOKEN_CAP_PER_STAGE=6000
AS_OF_DATE=2026-11-15
CREDASSURE_SEED=20261026

# Feature flags (default OFF)
FEATURE_STRETCH=false
PLANNER_MODE=fixed              # fixed | llm_proposes
ABLATION=                       # empty | A1..A5 (evaluation only)
EVAL_NUM_CTX=8192
EVAL_DIR=var/eval              # P9 scorecard: harness runs (make eval)
BASELINE_DIR=evaluation/baseline/results  # P9 scorecard: baseline S1-S3 results
# Baselines (Makefile baseline): EVAL_BASE_URL, EVAL_MODEL, EVAL_API_KEY, EVAL_CA_CERT (else LLM_CA_CERT),
# EVAL_MAX_TOKENS (course: 1024), EVAL_DISABLE_THINKING=true for Qwen3

# Web UI (apps/web, ADR 0020). NEXT_PUBLIC_* are baked into the static build.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_AUTH_MODE=gateway   # gateway = sign in with a gateway account (dev/test); bridge = finbridge auth service + MFA
# Auth service bridge (deploy/auth/server.py): gateway user ids per acting role; secret must equal JWT_SECRET.
# FB_JWT_SECRET=
# FB_GATEWAY_USERS={"preparer":"<id>","director_finance":"<id>","vp_finance":"<id>","evaluator":"<id>"}
# FB_GATEWAY_TENANT=default

# Copilot retrieval and model switch (docs/setup/environment.md)
COPILOT_SEARCH_MODE=hybrid       # hybrid (BM25 + dense, RRF) | keyword (BM25 only)
LLM_THINKING_SWITCH=chat_template_kwargs  # how "no thinking" is sent: chat_template_kwargs | reasoning_effort

# Data files (defaults are the frozen synthetic data; change only for tests)
HR_DB=data/frozen/v1/hr.db                              # opened read-only (ONB-05)
REFERENCE_RATES_FILE=data/reference/reference_rates.yaml  # repo + EBLR as of AS_OF_DATE (LW-08)
LENDER_SCRIPTS_DIR=data/frozen/v1/lender_scripts         # scripted lender replies (S05)
CORPUS_MANIFEST=data/corpus/manifest.yaml                # superseded but unindexed documents (VER-02)
HOME_STATE=IN-MH                                         # home jurisdiction for retrieval (ADR 0019)
