# CredAssure settings (apps/gateway/src/credassure/gateway/settings.py). Copy to .env and fill in.
# Never commit .env. Startup fails outside APP_ENV=test if JWT_SECRET (>=32 chars) is missing,
# or if LLM_BASE_URL is missing while LLM_ENABLED=true.

APP_ENV=dev                     # dev | test | demo
LOG_LEVEL=INFO
TENANT_ID=default

# Local default is Ollama (ADR 0017): llama3.1:8b chat + nomic-embed-text.
# Graded eval: replace the four values below with the course endpoint (P31 / M-01, M-02).
# Inside Compose the gateway uses http://ollama:11434/v1 instead of localhost.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama             # Ollama ignores it; the OpenAI SDK refuses an empty key
LLM_MODEL=llama3.1:8b
LLM_CONTEXT_TOKENS=8192        # matches OLLAMA_CONTEXT_LENGTH; not Llama 3.1's 128k default
LLM_SUPPORTS_GUIDED_JSON=false # Phase 6 probes Ollama JSON mode before turning this on
LLM_ENABLED=true               # false = template fallbacks; core workflow must still pass
# Model-call resilience (ADR 0008; scope #22, #23, #48)
LLM_CALL_TIMEOUT_S=30           # per attempt; a hung call ends as a SUP_TIMEOUT blocker
STAGE_TIMEOUT_S=300             # per stage; state is saved and the orphan is cancelled
LLM_MAX_RETRIES=2               # transient errors only (connection, timeout, 429, 5xx)
LLM_CIRCUIT_FAILURES=5          # consecutive failed calls before the circuit opens
LLM_CIRCUIT_OPEN_S=60           # while open, stages run on templates
LLM_RATE_PER_MINUTE=60          # shared limiter: agents and the baseline harness (NFR-04)
LLM_CACHE_PATH=var/llm_cache.db # empty = no response cache
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text   # changing this later requires a re-index
RERANKER=none                   # none | local_cross_encoder | llm_pointwise (ADR 0013)
RERANKER_MODEL=BAAI/bge-reranker-base

# Tracing: self-hosted Langfuse (ADR 0016). Keys come from the Langfuse UI after first start.
TRACING_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Auth
JWT_SECRET=
JWT_EXPIRY_MINUTES=30
UI_ORIGINS=http://localhost:5173

# Seed users for `make db` (Phase 5): 12+ characters, synthetic demo users only, never a real password.
# SEED_PASSWORD_<USERNAME> (dots as underscores, upper case) overrides it for one user.
SEED_PASSWORD=
CASE_DB=var/case.db
RATE_LIMIT=120/minute          # per user, else per IP (NFR-04)
TOKEN_QUOTA=2000000            # team token quota; 70% / 90% warnings (scope #16)
MAX_UPLOAD_BYTES=2097152       # 2 MB upload cap (UI-02)

# Corpus fetches (ADR 0020), both optional: a contact added to the scripted User-Agent.
# Email wins, else URL, else "CredAssure-capstone/1.0 (IIT KGP academic project)".
CORPUS_CONTACT_EMAIL=
CORPUS_CONTACT_URL=

# Money, routing and gates (exact values; BRD §8)
GST_RATE=0.18
APR_CONVENTION=nominal          # nominal | effective (ADR 0012)
BOUNDARY_RULE=hold              # hold | director | vp (APR-03)
APPROVAL_THRESHOLD_PAISE=1500000000
FORECAST_WEEKS=26
AGENT_MAX_STEPS=10
TOKEN_CAP_PER_STAGE=6000
AS_OF_DATE=2026-11-15
CREDASSURE_SEED=20261026

# Feature flags (default OFF)
FEATURE_STRETCH=false
PLANNER_MODE=fixed              # fixed | llm_proposes
ABLATION=                       # empty | A1..A5 (evaluation only)
EVAL_NUM_CTX=8192
