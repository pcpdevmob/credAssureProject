# ADR 0005 boundaries. `make check` runs `lint-imports`.
# Boundary 4 (apps/web imports only the API client) is TypeScript, checked in tests/test_boundaries.py.

[importlinter]
root_packages =
    credassure
include_external_packages = True

[importlinter:contract:agents-independent]
name = Agents do not import each other
type = independence
modules =
    credassure.agents.supervisor
    credassure.agents.onboarding
    credassure.agents.working_capital
    credassure.agents.lendwise
    credassure.agents.critic
    credassure.agents.copilot

[importlinter:contract:packages-not-agents]
name = Packages do not import agents or the gateway
type = forbidden
source_modules =
    credassure.core
    credassure.engines
    credassure.ledger
    credassure.llm
    credassure.observability
    credassure.reports
    credassure.retrieval
    credassure.security
    credassure.guardrails
    credassure.tools
    credassure.lender_sim
    credassure.evaluation
    credassure.datagen
forbidden_modules =
    credassure.agents
    credassure.gateway

[importlinter:contract:agents-via-supervisor]
name = Agent API modules do not import another agent's internals
type = independence
modules =
    credassure.agents.supervisor.api
    credassure.agents.onboarding.api
    credassure.agents.working_capital.api
    credassure.agents.lendwise.api
    credassure.agents.critic.api
    credassure.agents.copilot.api

[importlinter:contract:ledger-writes]
name = Only the ledger package imports the write module
type = forbidden
source_modules =
    credassure.agents
    credassure.core
    credassure.engines
    credassure.llm
    credassure.observability
    credassure.reports
    credassure.retrieval
    credassure.security
    credassure.tools
    credassure.lender_sim
    credassure.evaluation
    credassure.gateway
    credassure.datagen
forbidden_modules =
    credassure.ledger.writes
# Direct imports only: the sanctioned path is the adapter (ledger.store / ledger.seed), which is
# inside the ledger package. Agents are held to the stricter agents-use-ports contract below.
allow_indirect_imports = True

[importlinter:contract:openai]
name = Only the llm package imports the OpenAI SDK
type = forbidden
source_modules =
    credassure.agents
    credassure.core
    credassure.engines
    credassure.ledger
    credassure.observability
    credassure.reports
    credassure.retrieval
    credassure.security
    credassure.tools
    credassure.lender_sim
    credassure.evaluation
    credassure.gateway
    credassure.datagen
forbidden_modules =
    openai
# Direct imports only: the gateway wires credassure.llm.client (the adapter) into LLMPort.
allow_indirect_imports = True

[importlinter:contract:agents-use-ports]
name = Agents reach the ledger and the model only through ports (ADR 0006)
type = forbidden
source_modules =
    credassure.agents
forbidden_modules =
    credassure.ledger
    credassure.llm
    openai
    sqlalchemy

[importlinter:contract:datagen-independent]
name = Generators choose inputs; they never import the engines or gold (Phase 2)
type = forbidden
source_modules =
    credassure.datagen
forbidden_modules =
    credassure.engines
    credassure.evaluation

[importlinter:contract:evaluation-independent]
name = Evaluation gold and harness never import the engines or the generators (independent gold)
type = forbidden
source_modules =
    credassure.evaluation
forbidden_modules =
    credassure.engines
    credassure.datagen

[importlinter:contract:no-masking-on-figures]
name = PII masking is for free text only, never engine outputs or ledger fields
type = forbidden
source_modules =
    credassure.engines
    credassure.ledger
forbidden_modules =
    credassure.security.pii
    credassure.guardrails.pii

[importlinter:contract:guardrails-layer]
name = Guardrails import only core and observability (ADR 0029: core <- guardrails <- llm, adapters, gateway)
type = forbidden
source_modules =
    credassure.guardrails
forbidden_modules =
    credassure.engines
    credassure.ledger
    credassure.llm
    credassure.reports
    credassure.retrieval
    credassure.security
    credassure.tools
    credassure.lender_sim
    credassure.evaluation
    credassure.datagen
    openai
