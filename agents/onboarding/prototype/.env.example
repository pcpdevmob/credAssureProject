# Settings the Onboarding Agent reads from environment variables. All are optional.
# Copy the lines you need into your shell or deployment settings. NEVER commit a real key (BRD NFR-07).

# --- Model (leave all unset to use template explanations only; the decision never needs a model) ---
# A) Local development: Qwen3 8B on Ollama (same model family as the scored endpoint)
CREDASSURE_LLM_BASE_URL=http://localhost:11434/v1
CREDASSURE_LLM_MODEL=qwen3:8b
CREDASSURE_LLM_API_KEY=ollama
CREDASSURE_LLM_TIMEOUT=120

# B) Scored runs: the course's hosted Qwen3-8B (replace block A)
# CREDASSURE_LLM_BASE_URL=https://<your group host>:<port>/v1
# CREDASSURE_LLM_MODEL=Qwen/Qwen3-8B
# CREDASSURE_LLM_API_KEY=<your group key - type it into your shell, never into this file>
# CREDASSURE_LLM_CA_CERT=C:\Users\<you>\Downloads\<group cert>.crt

# Shared model settings
CREDASSURE_LLM_ATTEMPTS=2          # rewordings tried before the template is used
CREDASSURE_LLM_BACKOFF=2,4         # waits (s) before retrying a 429/503: at most two retries (NFR-04)
CREDASSURE_LLM_NO_THINK=auto       # auto = add /no_think and strip <think> for Qwen models
# CREDASSURE_LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# --- Data ---
CREDASSURE_DB=data/credassure.db   # cases + audit log (the team's shared database in integration)
CREDASSURE_HR_DB=data/hr.db        # synthetic HR store, opened read-only
CREDASSURE_USER_MAP=data/user_map.json   # UI login -> synthetic employee ID

# --- Browser access from the FinBridge UI (npm run dev) ---
CREDASSURE_UI_ORIGINS=http://localhost:3000

# --- Tracing (optional; pip install langfuse) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
