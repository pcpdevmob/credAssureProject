# FinBridge UI: .env.local  (in the UI project folder, next to package.json)
# Keep all other services on their mocks, and switch only onboarding to the live agent:
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_ONBOARDING_LIVE=true
# Where the backend is. Local: the Onboarding Agent's own server on port 8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# On the live site, use the same origin so nginx forwards it (no CORS needed):
# NEXT_PUBLIC_API_BASE_URL=/api
